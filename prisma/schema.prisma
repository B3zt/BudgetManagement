// ระบบจัดการงบประมาณศาล - Prisma schema
// ผังบัญชีลำดับชั้น 5 ระดับ เช่น 1.1.1.1.1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ตารางอ้างอิงผังบัญชี GFMIS (ใช้เป็นตัวเลือกใน selection box)
model GfmisAccount {
  id        String   @id @default(cuid())
  code      String   @unique // รหัสบัญชี GFMIS
  name      String // ชื่อบัญชีตามผังบัญชี GFMIS
  createdAt DateTime @default(now())

  @@index([name])
}

model ChartOfAccount {
  id String @id @default(cuid())

  // รหัสบัญชี (ของสำนักงาน) เช่น "1.1.1.1.1"
  code String @unique

  // ระดับของรายการ 1-5 คำนวณจากจำนวนส่วนของ code
  level Int

  // ชื่อบัญชีของสำนักงาน
  nameOffice String

  // รหัสบัญชี GFMIS (เลือกจาก GfmisAccount)
  gfmisCode String?

  // ชื่อบัญชีตามผังบัญชี GFMIS (เลือกจาก GfmisAccount)
  gfmisName String?

  // ลำดับชั้น (self relation)
  parentId String?
  parent   ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children ChartOfAccount[] @relation("AccountHierarchy")

  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disbursements       Disbursement[]
  disbursementEntries DisbursementEntry[]

  @@index([parentId])
  @@index([gfmisCode])
}

// รายการเบิกจ่ายจริงต่อบัญชี ต่อเดือน (ใช้ทำรายงานรายเดือน/รายไตรมาส และรายงาน 4 หมวด)
model Disbursement {
  id String @id @default(cuid())

  account   ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  fiscalYear Int // ปีงบประมาณ พ.ศ.
  month      Int // 1-12

  budgetAmount Decimal @db.Decimal(15, 2) // งบประมาณที่ได้รับจัดสรร

  // ยอดเบิกจ่ายจริงแยกตามแหล่งเงิน (ตามรายงานผลการเบิกจ่าย: เงินงบประมาณ / เงินค่าธรรมเนียมศาล)
  spentBudgetFund Decimal @default(0) @db.Decimal(15, 2) // เบิกจ่ายจากเงินงบประมาณ
  spentCourtFee   Decimal @default(0) @db.Decimal(15, 2) // เบิกจ่ายจากเงินค่าธรรมเนียมศาล

  // ยอดเบิกจ่ายจริงรวมทั้งหมด = spentBudgetFund + spentCourtFee (API คำนวณและบันทึกให้ทุกครั้ง; รายงานเดิมอ่านค่านี้)
  spentAmount Decimal @db.Decimal(15, 2)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, fiscalYear, month])
  @@index([fiscalYear, month])
}

// แหล่งเงินของรายการเบิกจ่าย
enum FundSource {
  BUDGET // เงินงบประมาณ
  COURT_FEE // เงินค่าธรรมเนียมศาล
}

// รายการเบิกจ่ายย่อยแต่ละรายการ ของบัญชีหนึ่งในเดือน/ปีงบประมาณหนึ่ง
// เมื่อมีรายการ ระบบรวมยอดไปเก็บใน Disbursement (spentBudgetFund / spentCourtFee / spentAmount) ให้อัตโนมัติ
model DisbursementEntry {
  id String @id @default(cuid())

  account   ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  fiscalYear Int // ปีงบประมาณ พ.ศ.
  month      Int // 1-12 เดือนที่นับยอด

  entryDate   DateTime? // วันที่เบิกจ่าย (ไม่บังคับ)
  description String? // รายละเอียด เช่น ค่าไฟฟ้าเดือน ต.ค.
  fundSource  FundSource @default(BUDGET)
  amount      Decimal    @db.Decimal(15, 2)

  createdAt DateTime @default(now())

  @@index([accountId, fiscalYear, month])
  @@index([fiscalYear, month])
}

// แบบแจ้งการโอนเงินงบประมาณประจำปี ของสำนักงานศาลยุติธรรม (ส่วนหัวเอกสาร)
// ยอดรวมแต่ละด้านและรวมทั้งสิ้น คำนวณจากรายการงาน/กิจกรรม (TransferItem) ไม่เก็บซ้ำ
model BudgetTransfer {
  id String @id @default(cuid())

  documentNo   String   @unique // เลขที่เอกสาร เช่น 69-01-0000102
  transferSeq  Int // โอนครั้งที่
  fiscalYear   Int // ปีงบประมาณ พ.ศ.
  documentDate DateTime // ลงวันที่
  transferDate DateTime // วันที่โอนเข้าบัญชี
  month        Int // ประจำเดือน 1-12
  quarter      Int // ประจำไตรมาส 1-4 (Q1 = ม.ค.-มี.ค., Q4 = ต.ค.-ธ.ค.)

  fromUnit String // โอนจากหน่วยงาน
  toUnit   String // ถึงหน่วยงาน

  remark     String? // หมายเหตุ
  preparedBy String? // ผู้จัดทำ

  items TransferItem[]

  createdAt DateTime @default(now())

  @@index([fiscalYear, quarter])
}

// รายการ งานประจำ - กิจกรรม / โครงการ ในแบบแจ้งโอน
model TransferItem {
  id String @id @default(cuid())

  transfer   BudgetTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId String

  lineNo   Int // ลำดับที่
  activity String // งานประจำ - กิจกรรม / โครงการ
  fiscalYear Int // ปีงบประมาณ

  personnelAmount  Decimal @default(0) @db.Decimal(15, 2) // ด้านบุคลากร
  managementAmount Decimal @default(0) @db.Decimal(15, 2) // ด้านบริหารจัดการ
  investmentAmount Decimal @default(0) @db.Decimal(15, 2) // ด้านลงทุน

  @@index([transferId])
}
